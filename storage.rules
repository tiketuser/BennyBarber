// Generated by `npm run firebase:rules` from shop.config.ts. Edit scripts/firebase-rules.mjs, not this file.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /shops/bennycohen/gallery/{file} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.phone_number in ["+972500000000"]
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
