// Generated by `npm run firebase:rules` from shop.config.ts. Edit scripts/firebase-rules.mjs, not this file.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /shops/bennycohen/gallery/{file} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.get('phone_number', '') in ["+972544437070","+972528887726"]
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    // "הוסף ליומן" on iPhone: each signed-in user (customers too) keeps one .ics file under their own id, replaced
    // on every add. 1 MB holds thousands of appointments (the admin's "כל התורים ליומן").
    match /shops/{shopId}/ics/{uid}/{file} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid && file == 'calendar.ics'
        && request.resource.size < 1024 * 1024
        && request.resource.contentType.matches('text/calendar.*');
    }
  }
}
