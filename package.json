{
  "name": "benny-barber",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:demo": "vite --host --mode demo",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b",
    "icons": "node --experimental-strip-types --no-warnings scripts/make-icons.mjs",
    "cap:sync": "npm run build && npx cap sync",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "node --experimental-strip-types --no-warnings e2e/run.mjs",
    "firebase:rules": "node --experimental-strip-types --no-warnings scripts/firebase-rules.mjs",
    "test:e2e:firebase": "firebase emulators:exec --only auth,firestore,storage \"E2E_BACKEND=firebase node --experimental-strip-types --no-warnings e2e/run.mjs\"",
    "test:rules": "firebase emulators:exec --only auth,firestore,storage \"node --experimental-strip-types --no-warnings e2e/rules-check.mjs\"",
    "deploy": "npm run build && npm run firebase:rules && firebase deploy --only hosting,firestore:rules,storage"
  },
  "dependencies": {
    "@capacitor/core": "^7.6.9",
    "@fontsource/rubik": "^5.3.0",
    "@fontsource/secular-one": "^5.3.0",
    "firebase": "^11.10.0",
    "lucide-react": "^0.577.0",
    "motion": "^11.18.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "firebase-tools": "^13.35.1",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.56.1",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.19",
    "typescript": "5.6",
    "typescript-eslint": "^8.71.2",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^2.1.9"
  }
}
